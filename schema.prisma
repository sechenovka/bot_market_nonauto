generator client {
  provider = "prisma-client-py"
  interface = "asyncio"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Business {
  id              String   @id @default(uuid())
  name            String
  inn             String?
  type            String?
  registration    String   @default("registered")
  description     String?
  routineProblems String?
  contacts        String?
  source          String?
  sourceUrl       String?
  isDevelopedTech Boolean  @default(false)
  isPosted        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([name, type])
}